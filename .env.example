# gkos.dev — environment
#
# Copy to .env.local and fill in your own values. Most of the site renders without any of
# these; only the stats, reactions, community wall and contact form need real credentials.

# ── Database: Supabase ────────────────────────────────────────────────────────────────────
# The wall, blog reactions, comments and CV download counts live in Postgres, reached through
# Supabase's auto-generated REST API. Create a free project at https://supabase.com, then take
# these three from Project Settings → API. The free tier is enough to run the whole site.
#
# The app talks to it with supabase-js and uses nothing but the REST API — no Auth, no Storage,
# no realtime — so any PostgREST instance in front of a Postgres with the same tables answers
# identically. That is only worth knowing if you already self-host; if you do, point
# PUBLIC_SUPABASE_URL at your own PostgREST and everything else stays the same. Supabase is the
# path this project documents and the one to use unless you have a reason not to.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SECRET_KEY=your-service-role-key

# ── Contact form ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=you@example.com
RESEND_TO_EMAIL=you@example.com
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret

# ── Live-data widgets (each is optional; its widget hides without it) ──────────────────────
GITHUB_TOKEN=ghp_your_token
HUGGINGFACE_USERNAME=your-hf-username

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── Analytics (optional) ──────────────────────────────────────────────────────────────────
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── Server-side secrets ───────────────────────────────────────────────────────────────────
# ADMIN_TOKEN_SECRET signs the admin session cookie; CRON_SECRET guards scheduled routes;
# IP_HASH_SALT salts visitor-IP hashes so raw addresses are never stored. Use long random
# strings, different from each other.
ADMIN_TOKEN_SECRET=
CRON_SECRET=
IP_HASH_SALT=

# Used only by the writing assistant in the admin area.
OPENAI_API_KEY=
